# Model transport
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

# Bounded orchestration
DSG_HYPER_ROUNDS=2
DSG_MODEL_TIMEOUT=90
DSG_ROUND_TIMEOUT=120
DSG_MODEL_CONCURRENCY=6
DSG_MAX_OUTPUT_TOKENS=2200
DSG_MAX_PROMPT_CHARS=32000
DSG_MAX_CONTEXT_CHARS=48000
DSG_TRACE_ROOT=outputs/traces
DSG_REQUIRE_LEDGER=0

# v23 Agent Information Economy
# Hard communication-market budget per recipient per round.
DSG_MARKET_TOKEN_BUDGET=4500
# Claims older than this many rounds expire from market routing.
DSG_FRESHNESS_TTL_ROUNDS=4
DSG_FRESHNESS_HALF_LIFE_ROUNDS=2.0
# Conflict-focused specialists are planned by default. Execution is opt-in.
DSG_SPECIALIST_LIMIT=2
DSG_SPECIALIST_TOKEN_QUOTA=3000
DSG_EXECUTE_SPECIALISTS=0
# Optional independent model IDs using the same configured compatible endpoint.
# Example: model-a,model-b,model-c
DSG_QUORUM_MODELS=
# Deterministic counterfactual market budgets for offline replay evaluation.
DSG_COUNTERFACTUAL_BUDGETS=1024,2048,4096
# Optional HMAC key for proof-carrying policy envelopes. This is NOT ZK or threshold auth.
DSG_POLICY_AUTH_KEY=

# PCESM encrypted semantic memory
DSG_MEMORY_NAMESPACE=hypercomm
# Recommended format: b64:<32+ random bytes encoded with URL-safe base64>
DSG_MEMORY_MASTER_KEY=
# Secure mode refuses persistent memory without a master key. Set this only for
# explicitly ephemeral development runs.
DSG_ALLOW_EPHEMERAL_MEMORY=0
DSG_MEMORY_SQLITE=outputs/secure_memory.sqlite3
DSG_MEMORY_RESULT_LIMIT=6
DSG_CAPABILITY_TTL=900
DSG_MEMORY_STORE_REQUEST=1
DSG_BLIND_VECTOR_DIMS=512

# Optional Weaviate backend. Namespace filtering is performed server-side.
WEAVIATE_URL=
DSG_WEAVIATE_COLLECTION=DSGPCESMMemory

# Optional CKKS encrypted-vector reranking. Requires TenSEAL.
DSG_ENABLE_CKKS=0
# For persistent HE ciphertext, provide serialized TenSEAL contexts. Without both,
# CKKS is session-only and ciphertext is not written to a persistent vector backend.
DSG_CKKS_PUBLIC_CONTEXT_B64=
DSG_CKKS_SECRET_CONTEXT_B64=
