OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
DSG_MESSAGE_SECRET=
DSG_TRACE_FILE=outputs/hypercomm_trace.jsonl
DSG_MAX_PAYLOAD_BYTES=65536
DSG_MAX_QUEUE=128
DSG_HYPER_ROUNDS=2
DSG_MODEL_TIMEOUT=90
DSG_MODEL_CONCURRENCY=6

# PCOSM secure semantic memory
# Use a persistent 32+ byte secret (base64, hex, or strong passphrase-derived value).
# If omitted, an ephemeral key is generated and persisted ciphertext cannot be reopened
# after restart.
DSG_MEMORY_MASTER_KEY=
WEAVIATE_URL=
DSG_WEAVIATE_COLLECTION=DSGPCOSMOpaqueMemory
DSG_BLIND_VECTOR_DIMS=256

# Optional CKKS homomorphic vector arithmetic. Requires TenSEAL installed separately.
DSG_ENABLE_CKKS=0
